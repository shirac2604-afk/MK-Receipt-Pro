    "vitest": "3.2.4",
    "wait-on": "8.0.3"
  },
  "build": {
    "appId": "il.co.mkreceipt.desktop",
    "productName": "מפתחות להצלחה",
    "protocols": [
      {
        "name": "MK Receipt Pro Password Recovery",
        "schemes": [
          "mkreceiptpro"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "resources/**/*"
    ],
    "artifactName": "Maptehot-LaHatzlaha-${version}-Setup.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/installer/app-icon.ico",
      "executableName": "MaptehotLaHatzlaha"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "מפתחות להצלחה",
      "uninstallDisplayName": "מפתחות להצלחה",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "resources/installer/app-icon.ico",
      "uninstallerIcon": "resources/installer/app-icon.ico",
      "installerHeaderIcon": "resources/installer/app-icon.ico",
      "license": "resources/legal/LICENSE-he.txt",
      "language": "1037"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      },
      {
        "from": "scripts/tax-open-simulator-fixture.mjs",
        "to": "scripts/tax-open-simulator-fixture.mjs"
      }
    ],
    "copyright": "Copyright © 2026 מפתחות להצלחה",
    "asar": true,
    "extraMetadata": {
      "name": "mk-receipt-pro",
      "productName": "מפתחות להצלחה"
    }
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10"
  }

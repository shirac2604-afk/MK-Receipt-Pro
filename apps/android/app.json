{
  "expo": {
    "name": "MK Receipt Pro",
    "slug": "mk-receipt-pro-android",
    "scheme": "mkreceiptpro",
    "version": "1.0.10",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "il.mkreceiptpro.android",
      "versionCode": 11,
      "permissions": [
        "CAMERA",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#F6F7F9"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "MK Receipt Pro זקוקה לגישה לתמונות כדי לצרף אסמכתאות להוצאות.",
          "cameraPermission": "MK Receipt Pro זקוקה למצלמה כדי לצלם אסמכתאות להוצאות."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "MK Receipt Pro זקוקה לגישה ליומן כדי לסנכרן את שיעורי התלמידים."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "student-reminders"
        }
      ]
    ],
    "icon": "./assets/app-icon.png"
  }
}
